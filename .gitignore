# IDE
.idea/
.vs/
.vscode/

# CMake / build outputs
/build/
/build-*/
/cmake-build-*/
/out/
/install/
/x64/
/Debug/
/Release/

# Binary artifacts (our target is generated MaaCore.dll + pdb, do not track)
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.obj
*.ipdb
*.iobj

# Runtime/dependency staging and caches
/runtime/
/debug/
/tarball/
/x-tools/

# MaaUtils is vendored in-tree (source tracked). Its upstream MaaDeps download
# cache is not used by this repo and must never be committed.
/MaaUtils/MaaDeps/

# Standalone bootstrap cache and generated asset mirror
_upstream/
.bootstrap/

# Vendored (repo-local) prebuilt dependencies
/deps/

# Packaged release artifacts
/dist/

# Optional local mirrors / backups
/3rdparty/include._bak/
/resource._bak/

# Python
__pycache__/
*.pyc

patch

# Windows explorer / misc
Thumbs.db
desktop.ini
*.log

# CMake user presets
/CMakeUserPresets.json

